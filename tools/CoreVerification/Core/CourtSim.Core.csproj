<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the engine-independent CourtSim.Core sources outside Unity, against the same
    API surface Unity 2022.3 exposes (.NET Standard 2.1, C# 9). Unity itself compiles these
    files through Assets/Scripts/Core/CourtSim.Core.asmdef; this project exists only so CI
    and contributors can build, lint and test the core without a Unity licence.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>CourtSim.Core</RootNamespace>
    <AssemblyName>CourtSim.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591/CS1573: XML docs are required where they add information, not on every member/parameter. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Assets/Scripts/Core/**/*.cs" />
  </ItemGroup>

</Project>
