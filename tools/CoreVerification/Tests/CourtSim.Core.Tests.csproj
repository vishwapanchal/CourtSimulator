<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the Assets/Tests/EditMode NUnit suite outside Unity. The same files also run inside
    the Unity Test Runner, so tests must stick to APIs available in Unity's bundled NUnit 3.5.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for IDE0005 (unused usings) to run on build; test docs themselves are not required. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: tests are self-describing. NUnit2005/2045: newer constraint styles than Unity's NUnit 3.5 supports. -->
    <NoWarn>$(NoWarn);CS1591;NUnit2005;NUnit2045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Assets/Tests/EditMode/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/CourtSim.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

</Project>
